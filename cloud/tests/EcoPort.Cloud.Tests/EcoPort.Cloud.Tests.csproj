<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- mtp-off: run through VSTest (xunit.runner.visualstudio), so `dotnet test` works from any
         directory on the .NET 10 SDK without a global.json opting into Microsoft.Testing.Platform. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EcoPort.Cloud.Contracts\EcoPort.Cloud.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EcoPort.Cloud.Core\EcoPort.Cloud.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\contracts\device-v1\*.json" Link="contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
