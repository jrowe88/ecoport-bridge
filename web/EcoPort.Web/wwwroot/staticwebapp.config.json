{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/login.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["bench"]
    },
    {
      "route": "/*",
      "allowedRoles": ["bench"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    },
    "403": {
      "redirect": "/login.html",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/login.html",
      "/_framework/*",
      "/_content/*",
      "/css/*",
      "*.{js,json,webmanifest,css,png,ico,svg,wasm,dll,pdb,dat,blat,gz,br}"
    ]
  },
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  }
}
