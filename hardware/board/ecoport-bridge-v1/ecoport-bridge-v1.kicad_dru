(version 1)
(rule "Mains to edge"
	(constraint edge_clearance (min 3mm))
	(condition "A.hasNetclass('Mains')")
)
(rule "Mains to SELV"
  (condition "A.NetClass == 'Mains' && B.NetClass != 'Mains' && B.NetClass != 'Earth'")
  (constraint clearance (min 4mm))
  (constraint creepage (min 6mm)))
(rule "Mains to SELV at J1"
  (condition "A.NetClass == 'Mains' && B.NetClass != 'Mains' && B.NetClass != 'Earth' && B.memberOfFootprint('J1')")
  (constraint clearance (min 4mm))
  (constraint creepage (min 5.5mm)))
(rule "Mains to Earth"
  (condition "A.NetClass == 'Mains' && B.NetClass == 'Earth'")
  (constraint clearance (min 3mm)))
(rule "Line to line"
	(constraint clearance (min 2.5mm))
	(condition "A.hasNetclass('Mains') && B.hasNetclass('Mains') && A.Net != B.Net")
)
(rule "Fuse pads"
  (condition "A.memberOfFootprint('F1') && B.memberOfFootprint('F1')")
  (constraint clearance (min 0.5mm)))
(rule "USB-C pin pitch"
  (condition "A.memberOfFootprint('J4') && B.memberOfFootprint('J4')")
  (constraint clearance (min 0.15mm)))
(rule "Mouse bites"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint edge_clearance (min 0mm))
  (constraint hole_to_hole (min 0mm)))
