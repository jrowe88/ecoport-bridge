	(text "ESP32-C6 Module"
		(exclude_from_sim no)
		(at 289.56 102.616 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "16a72e4a-216d-4ec4-b64a-1c571a9b1d62")
	)
	(text "WARNING: Both line voltage (120V AC Per Line as well as RS-485 5V DC signal is provided through this terminal.\nUse extreme caution around the high voltage pins and components.\n\n240 AC is converted to 5V - 1A DC through the IRM-05-5 converter.  This establishes a 5V rail where needed.\n5V DC is converted to 3.3V through the LDO Regulator.  This establishes the 3.3V rail used by most components.\n\nRS485 signal is provided via two Pins 1 and 7 of the connector."
		(exclude_from_sim no)
		(at 33.274 25.908 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "216d77b3-faf6-4381-82a3-987fc752768e")
	)
	(text "NOTE:\nJ6 and J7\nconnected\nby wire"
		(exclude_from_sim no)
		(at 195.072 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "22216255-73b7-4da5-99b5-e6d23bbbd6ef")
	)
	(text ""
		(exclude_from_sim no)
		(at 74.168 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2f489c59-b9b7-49c8-af0c-218be68c54df")
	)
	(text "EcoPort Connector and Power Conversion"
		(exclude_from_sim no)
		(at 33.02 22.86 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "2fd3e36b-db79-444a-9f21-a7c30c6374e8")
	)
	(text "High Voltage"
		(exclude_from_sim no)
		(at 43.942 54.864 0)
		(effects
			(font
				(size 1.778 1.778)
			)
		)
		(uuid "364e8f44-76cf-486d-88ae-b2dad99a794e")
	)
	(text "An I2C connector is provided to allow connection to sensor breakout boards.  The JST 4-pin connector\nis compatible with Adafruit Stemma QT or SparkFun Qwiic connectors.  Other I2C devices are supported\nbut a connector adaptor may be required.  The intention is for a connecting an external sensor, such\nas a temperature and humidity sensor."
		(exclude_from_sim no)
		(at 36.068 101.854 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "562eb4ab-9a52-44cb-bd9d-445217db8dd7")
	)
	(text "The module is built around the ESP32-C6.  It provides 8MB of\nflash RAM and an on-board PCB antenna.\n\nTwo tactile buttons are provided for reset and to control \nboot options. Tap RESET to reset the Board.  Hold BOOT and \ntap RESET to enter download mode."
		(exclude_from_sim no)
		(at 289.56 105.664 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "5d22825a-0bc7-4da6-8cef-3060f905d6c4")
	)
	(text "RS-485 Transceiver"
		(exclude_from_sim no)
		(at 237.998 29.972 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "6d7ef392-5937-4b98-a221-44e1ec035bee")
	)
	(text "Unknown vendor data pin output."
		(exclude_from_sim no)
		(at 152.908 202.184 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "6e54ea69-781f-488e-8568-d6aa83826627")
	)
	(text "Test Points"
		(exclude_from_sim no)
		(at 214.376 199.644 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "86f509bc-bd7c-4682-9f35-e983f7c61dc2")
	)
	(text "USB-C Connector"
		(exclude_from_sim no)
		(at 36.068 180.848 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "8d49a233-23f0-4743-a680-364330761342")
	)
	(text "SP3485 converts Data+/- RS-485 signal pair into a UART RX/TX. This is\nnot an auto-sensing transceiver and half-duplex communication must be\ncontrolled from the DE/RE pins.\n\nNOTE: If this is the last device in the chain, then the jumper should\nremain in place.  If additional RS-485 devices are connected, then\nthe jumper should be removed."
		(exclude_from_sim no)
		(at 237.998 33.02 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "cb464846-1cdc-4fec-91bc-fdc4ee5b5b9f")
	)
	(text "NOTE: only place bias\nresistors if this node\nprovides bus bias."
		(exclude_from_sim no)
		(at 272.034 76.454 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "d76a56e1-95c8-4369-9a0f-6db4ada76c33")
	)
	(text "Vendor Data"
		(exclude_from_sim no)
		(at 152.908 199.136 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "dff9ad09-df73-49e5-a7b2-3865afa4162d")
	)
	(text "Indicator LEDs using WS2812 integrated, addressable LEDs.\nOr, in Adafruit paralances, NeoPixels.  These are powered \nby the 5V rail and MCU signal raised from 3.3V to 5V by \nthe logic level shifter.\n\nNOTE: LEDs are placed on a separate board, connected\nby a 3-wire JST-SH connector from the main board."
		(exclude_from_sim no)
		(at 132.08 112.014 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "ee6be965-2ad7-4584-98fa-78380cfae063")
	)
	(text "USB-C connector is provided for loading firmware or troubleshooting. This connector\ndoes *not* connect VBUS to the circuit. You cannot power the board from this connector\nnor receive power.  Only the USB data D- and D+ pins are connected."
		(exclude_from_sim no)
		(at 36.068 183.896 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "f05edadd-d0e1-481a-9cee-d097d5495841")
	)
